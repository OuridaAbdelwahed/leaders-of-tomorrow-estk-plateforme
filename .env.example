# Application security. Generate unique values for every environment.
NEXT_PUBLIC_SITE_URL=https://leadersoftomorrowestk.com
SITE_URL=https://leadersoftomorrowestk.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SECURITY_CONTACT_EMAIL=ouridaabdelwahed@gmail.com
SECURITY_TXT_EXPIRES=2027-07-28T00:00:00.000Z
ADMIN_PORTAL_SLUG=9dd0f28eb5a24681ee18a33be1640ca112a13b2add30a414c47ddd5fba6b0b51f5a534c8de8963b9263c369ff4f84b2077b10c7fce1ed95443176e2ed0f7a250
SESSION_SECRET=0b4f4659fa887e6d45b597bf2e1a9ffd3c5825722a5de947b3737474a18f8f13
COOKIE_SECURE=false

# MariaDB / MySQL (WampServer-compatible; an empty local root password is supported).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leaders_db
DB_USERNAME=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
MYSQL_SSL=false

# Optional legacy aliases. Prefer the DB_* variables above.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=leaders_db
# MYSQL_USER=root
# MYSQL_PASSWORD=

# Optional SMTP delivery. Without a complete configuration, email is simulated.
MAIL_USERNAME=members@example.org
MAIL_PASSWORD=replace-with-an-app-password
MAIL_FROM=New Leaders of Tomorrow <members@example.org>
MAIL_SERVER=smtp.example.org
MAIL_PORT=587
MAIL_TLS=true

# No-login visitor ticket verification.
# Add the public key to NEXT_PUBLIC_* for the browser widget; keep the secret key private.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=localhost,leadersoftomorrowestk.com
TICKET_OTP_EXPIRES_MINUTES=10
TICKET_VERIFICATION_EXPIRES_MINUTES=15
TICKET_OTP_RESEND_COOLDOWN_SECONDS=45
TICKET_OTP_MAX_ATTEMPTS=5
TICKET_OTP_EMAIL_LIMIT=4
TICKET_OTP_DEVICE_LIMIT=8
TICKET_OTP_IP_LIMIT=20
TICKET_DEVICE_POLICY=strict
OTP_HASH_SECRET=replace-with-64-hex-secret
VERIFICATION_TOKEN_HASH_SECRET=replace-with-64-hex-secret
DEVICE_TOKEN_HASH_SECRET=replace-with-64-hex-secret
FINGERPRINT_HASH_SECRET=replace-with-64-hex-secret
IP_HASH_SECRET=replace-with-64-hex-secret
EMAIL_HASH_SECRET=replace-with-64-hex-secret

# Optional donation popup and PayPal Checkout.
# Keep PAYPAL_CLIENT_SECRET private on the server. Do not expose card fields in the app.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# Optional donation popup behavior. The popup is shown once per session, and then suppressed for a number of days depending on the user's response.

DONATION_POPUP_SESSION_LIMIT=1
DONATION_POPUP_LATER_DAYS=7
DONATION_POPUP_DECLINED_DAYS=30
DONATION_POPUP_DONOR_DAYS=90
DONATION_POPUP_SCROLL_THRESHOLD=90

# Intelligent multilingual club assistant. Keep OPENAI_API_KEY server-side only.
CHATBOT_ENABLED=true
CHATBOT_LLM_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
CHATBOT_LLM_REASONING_EFFORT=low
CHATBOT_LLM_VERBOSITY=medium
CHATBOT_LLM_MAX_OUTPUT_TOKENS=700
CHATBOT_LLM_TIMEOUT_MS=25000
CHATBOT_DEFAULT_LANGUAGE=fr
CHATBOT_SUPPORTED_LANGUAGES=ar,fr,en,darija
CHATBOT_MAX_MESSAGE_LENGTH=2000
CHATBOT_HISTORY_LIMIT=12
CHATBOT_RATE_LIMIT_PER_MINUTE=10
CHATBOT_GUEST_RATE_LIMIT_PER_HOUR=100
CHATBOT_STORE_GUEST_CONVERSATIONS=true
CHATBOT_RETENTION_DAYS=90
CHATBOT_HUMAN_HANDOFF_ENABLED=true
CHATBOT_PLATFORM_SYNC_SECONDS=300
CHATBOT_TRAINING_MAX_FILE_MB=15
# Reserved extension flag. Keep false until a reviewed internal implementation exists.
CHATBOT_SEMANTIC_MATCHING_ENABLED=false
